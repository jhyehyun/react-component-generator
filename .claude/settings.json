{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { bun run test >&2 || { echo '테스트가 실패하여 커밋을 차단했습니다. 모든 테스트를 통과시킨 뒤 다시 커밋하세요.' >&2; exit 2; }; }",
            "timeout": 300,
            "statusMessage": "커밋 전 테스트 실행 중..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.ts\"",
            "timeout": 10,
            "statusMessage": "TDD 규칙 리마인드 중..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",
      "Bash(*.env*)",
      "Bash(*credential*)",
      "Bash(*secret*)",
      "Bash(*.pem*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*.ssh*)",
      "Bash(*.aws*)",
      "PowerShell(*.env*)",
      "PowerShell(*credential*)",
      "PowerShell(*secret*)",
      "PowerShell(*.pem*)",
      "PowerShell(*id_rsa*)",
      "PowerShell(*id_ed25519*)",
      "PowerShell(*.ssh*)",
      "PowerShell(*.aws*)"
    ]
  }
}
